# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
# Either the SRV form (mongodb+srv://) or the standard multi-host form (mongodb://host1,host2,host3/...).
# Special characters in the password must be URL-encoded.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
# Browser origins allowed by CORS, comma-separated, no trailing slash. Empty = none.
# "*" is rejected when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Max JSON body size (for example 100kb, 1mb).
BODY_LIMIT=100kb
# Number of reverse proxies in front of the app. 0 = none (local development).
# Set it to the real number of proxies when deployed behind them (for example 1 for a single proxy).
TRUST_PROXY_HOPS=0
# bcrypt cost factor (minimum 10). Each +1 doubles the hashing time.
BCRYPT_SALT_ROUNDS=12
